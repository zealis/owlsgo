# ============================================================================
#  owlsgo —— Nginx 伪静态规则
# ============================================================================
#  「nginx.htaccess」这个文件名是 phpStudy Pro（小皮面板）的约定：
#  创建站点时它会在站点根目录生成这个文件，并在 `location / { ... }` 内部
#  用 include 引入。在面板「网站 → 管理 → 伪静态」里填的规则，写的就是它。
#
#  所以：
#    - 用 phpStudy / 小皮：什么都不用做，本文件会被自动加载
#    - 自建 Nginx：把下面那行 try_files 抄进你的 server 块（或 location /）
#
#  规则说明：
#    - 真实存在的文件/目录（CSS、JS、图片、favicon）由 Nginx 直接返回
#    - 其余请求一律交给入口 index.php，
#      否则 /install、/login、/t/12 这类伪静态地址会因为「文件不存在」而 404
#    - 保留原始查询串（$query_string），否则分页、搜索参数会丢失
#
#  ⚠️ 本文件被 include 在 location / 内部，因此**不能再嵌套 location 块**，
#     否则 Nginx 会因语法错误直接启动失败。
# ============================================================================

# ----------------------------------------------------------------------------
# 隐藏文件与部署配置文件：一律 404，禁止外部访问
#
# 为什么必须挡：
#   - `/.htaccess`、`/nginx.htaccess` 可直接下载 —— 里面有服务器配置与路径信息；
#   - 站点根若被误设为仓库根（forum/），`/.git/config`（含远端地址）、`/.env`、
#     `/.tools/` 会一并暴露。哪怕现在没暴露，这条规则是最便宜的兜底。
#
# 为什么写成 `if` 而不是 `location`：
#   本文件被 phpStudy include 在 `location / { … }` **内部**，Nginx 不允许在
#   location 里再嵌套 location（会直接启动失败）。`if ($request_uri ~ …) { return 404; }`
#   在这种场景下是安全的用法（只做 return，不涉及 add_header / proxy_pass 那类陷阱）。
#
# 用 `$uri` 而不是 `$request_uri`：
#   - `$request_uri` **含查询串**，`/search?q=/.git` 这类正常请求会被误杀成 404；
#   - `$uri` 只含路径且已 URL 解码，`/%2ehtaccess`（编码的点）也照样命中 —— 两头都占。
#
# `.well-known` 必须放行：Let's Encrypt / ACME 证书验证、部分第三方校验依赖该路径。
# 返回 404 而不是 403：对外不承认文件存在（403 反而等于确认了「这里有东西」）。
# ----------------------------------------------------------------------------
if ($uri ~ "/\.(?!well-known/)") {
    return 404;
}

# nginx.htaccess 文件名不以点开头（上面那条盖不住），
# 它是给 phpStudy 用的伪静态片段，对外没有任何用途，禁止被下载。
if ($uri ~* "/nginx\.htaccess$") {
    return 404;
}

# 兜底：万一项目文件（文档、数据库、备份、配置）被误放进 public/，也不允许下载。
if ($uri ~* "\.(md|sql|sqlite|sqlite3|db|ini|log|json|lock|yml|yaml|bak|tmp|dist)$") {
    return 404;
}

try_files $uri $uri/ /index.php?$query_string;

# ----------------------------------------------------------------------------
# 静态资源长缓存
#
# 模板里所有 CSS/JS/图标都经 asset() 输出，URL 自带 ?v=<文件mtime>：
# 文件一变，URL 就变，浏览器自然重新下载 —— 所以这里可以放心给足缓存。
# 之前没有任何 expires 指令，浏览器每次进页面都把 app.js / theme.css
# 全量重拉一遍，是整站「卡卡的」的最大单一来源。
#
# 只影响 location / 下 Nginx 直接返回的静态文件；PHP 动态响应走
# location ~ \.php$（fastcgi），不受这一行影响。
# ----------------------------------------------------------------------------
expires 7d;
